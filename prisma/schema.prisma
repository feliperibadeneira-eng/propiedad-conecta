// Modelo de datos de Propiedad Conecta (MVP de marketplace de demanda inmobiliaria).
// Ver README.md para el resumen del flujo de negocio.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  BUYER
  AGENT
  ADMIN
}

enum OperationType {
  COMPRAR
  ALQUILAR
}

enum PropertyType {
  DEPARTAMENTO
  CASA
  TERRENO
  OFICINA
  LOCAL_COMERCIAL
  BODEGA
  OTRO
}

enum ContactPreference {
  WHATSAPP
  LLAMADA
  EMAIL
}

// Estado de la solicitud tal como lo ve el comprador (sección 10).
enum RequestStatus {
  BUSCANDO
  EN_PROCESO
  PAUSADA
  CERRADA
}

// Estado de una compra individual de lead (sección 19-23, más la garantía
// de créditos). Varias compras pueden coexistir sobre la misma solicitud
// (hasta requestId.maxAgents).
enum LeadPurchaseStatus {
  PURCHASED
  CONTACTED
  RESPONDED
  NO_CONTACT
  NO_MATCH
  RELEASED
  REACTIVATED
  REFUND_REQUESTED
  REFUNDED
  APPOINTMENT_SCHEDULED
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LeadTier {
  BASIC
  QUALIFIED
  PREMIUM
}

// Paquetes de créditos que un agente puede comprar (sección 2). Precios y
// créditos fijos, no configurables — ver lib/services/creditPackages.ts.
enum CreditPackageType {
  STARTER
  PRO
  PREMIUM
}

// Estado de una solicitud de compra de créditos (sección 4): el pago es
// manual, así que empieza en PENDING y un admin lo revisa.
enum CreditPurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

// Estado de una propiedad publicada por un agente (el gemelo de oferta de
// RequestStatus). Deliberadamente no se bifurca CERRADA en VENDIDA/ALQUILADA:
// igual que RequestStatus, no se condiciona el status a operationType.
enum PropertyStatus {
  DISPONIBLE
  PAUSADA
  CERRADA
}

// Tipo de mensaje dentro de una Conversation (PR #16). Deliberadamente
// sin SYSTEM todavía: los eventos de ciclo de vida siguen viviendo solo
// en LeadStatusHistory — SYSTEM se agregaría de forma aditiva en un PR
// futuro si se aprueba, nunca reemplazando esa fuente de verdad.
enum ConversationMessageType {
  TEXT
  PROPERTY_SHARE
}

// Hacia quién fluye el dato revelado (protección bilateral de contactos):
// BUYER_TO_AGENT = se reveló el contacto del comprador, visible para el
// agente; AGENT_TO_BUYER = se reveló el contacto del agente, visible para
// el comprador. Nombrado así (no "quién lo reveló") porque quien ejecuta
// la acción ya queda registrado en ContactRevealEvent.revealedByUserId —
// este campo describe el flujo del dato, no al actor.
enum ContactRevealDirection {
  BUYER_TO_AGENT
  AGENT_TO_BUYER
}

// Método de contacto revelado. OTHER queda reservado para un medio futuro
// que todavía no existe en el producto (ver especificación de protección
// de contactos) — no se usa hoy.
enum ContactMethod {
  PHONE
  WHATSAPP
  EMAIL
  OTHER
}

// Camino por el que se originó un ContactRevealEvent — ver especificación
// de protección de contactos, sección 3.
enum ContactRevealPath {
  AGENT_INITIATED
  BUYER_REQUEST_APPROVED
}

enum ContactReleaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RefundRequestCategory {
  NO_RESPONSE
  LEAD_QUALITY
  PLATFORM_ERROR
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Auth ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buyerProfile                  BuyerProfile?
  agentProfile                  AgentProfile?
  sessions                      Session[]
  notifications                 Notification[]
  auditLogs                     AuditLog[]
  reviewedCreditPurchases       CreditPurchaseRequest[]
  conversationMessages          ConversationMessage[]
  contactRevealsInitiated       ContactRevealEvent[]    @relation("ContactRevealInitiatedBy")
  contactRevealsAuthorized      ContactRevealEvent[]    @relation("ContactRevealAuthorizedBy")
  contactRevealsExecuted        ContactRevealEvent[]    @relation("ContactRevealRevealedBy")
  contactReleaseRequestsMade    ContactReleaseRequest[] @relation("ContactReleaseRequestedBy")
  contactReleaseRequestsDecided ContactReleaseRequest[] @relation("ContactReleaseDecidedBy")
  refundRequestsMade            RefundRequest[]         @relation("RefundRequestedBy")
  refundRequestsDecided         RefundRequest[]         @relation("RefundDecidedBy")

  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Perfiles ----------

model BuyerProfile {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  whatsapp                 String?
  contactPreference        ContactPreference @default(WHATSAPP)
  // Autorización dada una sola vez, al registrarse (sección 1), en vez de
  // pedirla de nuevo en cada solicitud.
  contactConsent           Boolean           @default(false)
  // Señal de confianza "ha confirmado que sigue buscando" (sección 3): se
  // actualiza cuando elige esa opción en "¿Qué ocurrió?" sobre cualquiera
  // de sus solicitudes.
  lastConfirmedSearchingAt DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests PropertyRequest[]
}

model AgentProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  photoUrl        String?
  whatsapp        String?
  company         String?
  city            String?
  yearsExperience Int?
  workAreas       String[]       @default([])
  propertyTypes   PropertyType[] @default([])
  description     String?
  // Sistema de créditos (sección 5): cada lead desbloqueado consume 1.
  creditsBalance  Int            @default(20)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases       LeadPurchase[]
  payments        Payment[]
  creditLedger    CreditLedgerEntry[]
  creditPurchases CreditPurchaseRequest[]
  properties      Property[]
}

// ---------- Solicitudes (el "inventario" de demanda) ----------

model PropertyRequest {
  id            String        @id @default(uuid())
  buyerId       String
  operationType OperationType
  propertyType  PropertyType

  provincia String
  ciudad    String
  sector    String?

  priceMin Decimal @db.Decimal(12, 2)
  priceMax Decimal @db.Decimal(12, 2)

  bedrooms        Int?
  bathrooms       Int?
  minSquareMeters Int?
  parkingSpots    Int?
  moveInDate      DateTime?

  // "Cuéntales un poco sobre ti" (opcional): ayuda al agente a confiar más
  // en la solicitud, nunca es obligatorio para publicar.
  occupation      String?
  searchReason    String?
  additionalNotes String?

  contactName        String
  contactPhone       String
  contactEmail       String?
  contactPreference  ContactPreference
  dataSharingConsent Boolean           @default(false)

  maxAgents Int     @default(3)
  leadPrice Decimal @db.Decimal(12, 2)

  status RequestStatus @default(BUSCANDO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer         BuyerProfile        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  features      RequestFeature[]
  purchases     LeadPurchase[]
  payments      Payment[]
  exchanges     ContactExchange[]
  statusHistory LeadStatusHistory[]

  @@index([buyerId])
  @@index([status])
  @@index([propertyType])
  @@index([provincia, ciudad, sector])
  @@index([priceMin, priceMax])
  @@index([createdAt])
}

// Características adicionales, guardadas como pares clave/valor para no
// llenar PropertyRequest de columnas nulas (amoblado, ascensor, terraza...).
model RequestFeature {
  id        String   @id @default(uuid())
  requestId String
  key       String
  value     String
  createdAt DateTime @default(now())

  request PropertyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, key])
  @@index([requestId])
}

// ---------- Propiedades (el "inventario" de oferta) ----------

// Publicación de un agente. Primera versión: sin relación todavía hacia
// PropertyRequest/LeadPurchase/ContactExchange — eso llega con matching y
// desbloqueo bidireccional (Property -> Match -> LeadPurchase ->
// Conversation -> ContactExchange), que son pasos futuros aditivos y no
// requieren modificar nada de este modelo.
model Property {
  id            String        @id @default(uuid())
  agentId       String
  operationType OperationType
  propertyType  PropertyType

  title       String
  description String?

  price Decimal @db.Decimal(12, 2)

  provincia String
  ciudad    String
  sector    String?

  squareMeters Int
  bedrooms     Int?
  bathrooms    Int?

  status PropertyStatus @default(DISPONIBLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent         AgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  images        PropertyImage[]
  leadPurchases LeadPurchase[]
  shares        PropertyShare[]

  @@index([agentId])
  @@index([status])
  @@index([propertyType])
  @@index([provincia, ciudad, sector])
  @@index([price])
  @@index([createdAt])
}

// Fotos de una propiedad. El binario vive en Postgres (igual que
// CreditPurchaseRequest.receiptImageData) — no hay proveedor de storage
// externo en el proyecto, así que se reutiliza el mismo patrón en vez de
// introducir infraestructura nueva. isPrimary no tiene un constraint de
// unicidad a nivel de DB (Prisma no soporta índices únicos parciales en su
// DSL) — la exclusividad de "una sola portada por propiedad" se garantiza
// en la capa de servicio (propertyImages.ts), igual que el resto de
// estados mutuamente excluyentes de este proyecto (ver recomputeRequestStatus).
model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  data       Bytes
  mimeType   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ---------- Compra de leads ----------

model LeadPurchase {
  id         String  @id @default(uuid())
  requestId  String
  agentId    String
  paymentId  String  @unique
  // Propiedad del agente desde la que se originó este desbloqueo (opcional
  // — un agente puede desbloquear sin pasar por el matching de ninguna
  // propiedad, igual que siempre). Es atribución histórica, no una
  // referencia que deba seguir vigente: sobrevive sin cambios si la
  // propiedad se pausa/cierra después (onDelete: SetNull si se borra).
  propertyId String?

  status      LeadPurchaseStatus @default(PURCHASED)
  pricePaid   Decimal            @db.Decimal(12, 2)
  creditsUsed Int                @default(1)

  purchasedAt               DateTime  @default(now())
  contactedAt               DateTime?
  refundRequestedAt         DateTime?
  refundedAt                DateTime?
  releasedAt                DateTime?
  releaseReason             String?
  // Irreversible — se fija con el primer ContactRevealEvent (cualquier
  // dirección/método) y nunca se limpia. Ver especificación de protección
  // de contactos: bloquea NO_RESPONSE/LEAD_QUALITY en RefundRequest.
  externalContactRevealedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request                PropertyRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  agent                  AgentProfile            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  payment                Payment                 @relation(fields: [paymentId], references: [id])
  property               Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  exchange               ContactExchange?
  conversation           Conversation?
  statusHistory          LeadStatusHistory[]
  ledgerEntries          CreditLedgerEntry[]
  propertyShares         PropertyShare[]
  contactReveals         ContactRevealEvent[]
  contactReleaseRequests ContactReleaseRequest[]
  refundRequests         RefundRequest[]

  // Un agente no puede comprar el mismo lead dos veces (regla 4), incluso
  // si el lead se reactiva más adelante para otros agentes.
  @@unique([requestId, agentId])
  @@index([requestId])
  @@index([agentId])
  @@index([status])
  @@index([propertyId])
}

// Registra que el agente compartió/ofreció una Property concreta con el
// comprador de un LeadPurchase ya desbloqueado (PR #15). Semántica exacta:
// "el agente la compartió" — NO implica que el comprador la haya visto,
// abierto o mostrado interés; eso queda deliberadamente fuera de alcance
// (no hay estado de interés/reacciones todavía).
//
// Distinto de LeadPurchase.propertyId (PR #14, atribución histórica del
// origen del unlock, admite PAUSADA/CERRADA): esto es una acción activa
// hacia adelante, por eso el servicio solo permite compartir propiedades
// DISPONIBLE.
//
// propertyId es nullable (a diferencia de requerido) para que, si una
// Property llegara a borrarse físicamente alguna vez (hoy no existe
// ningún flujo de la app que lo haga), el historial comercial de que se
// compartió algo en esa fecha no desaparezca junto con la fila entera —
// solo se desvincula (onDelete: SetNull), igual que LeadPurchase.propertyId.
// leadPurchaseId sí usa Cascade: sin su LeadPurchase, la fila no tiene
// ninguna identidad (ni agente ni comprador) y no queda nada útil que
// preservar — mismo criterio que ya usa ContactExchange.leadPurchaseId.
model PropertyShare {
  id             String   @id @default(uuid())
  leadPurchaseId String
  propertyId     String?
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  leadPurchase LeadPurchase          @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)
  property     Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  messages     ConversationMessage[]

  // Compartir la misma propiedad otra vez con el mismo lead no crea una
  // fila nueva (sección 5 del informe) — es un hecho binario, no un log de
  // cada reenvío.
  @@unique([leadPurchaseId, propertyId])
  @@index([leadPurchaseId])
  @@index([propertyId])
}

// Ledger de créditos (sección 6/10): registro inmutable de cada movimiento
// de crédito, para poder auditar que el saldo de AgentProfile siempre
// coincida con la suma de sus movimientos.
model CreditLedgerEntry {
  id                      String   @id @default(uuid())
  agentId                 String
  // Negativo = consumo (desbloqueo), positivo = compra aprobada, devolución
  // o ajuste manual.
  amount                  Int
  balanceAfter            Int
  reason                  String
  // Texto legible para "Historial de créditos" (sección 7), ej. "Compra de
  // paquete Pro" o "Desbloqueo de solicitud de compra".
  description             String?
  leadPurchaseId          String?
  creditPurchaseRequestId String?
  createdAt               DateTime @default(now())

  agent                 AgentProfile           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadPurchase          LeadPurchase?          @relation(fields: [leadPurchaseId], references: [id], onDelete: SetNull)
  creditPurchaseRequest CreditPurchaseRequest? @relation(fields: [creditPurchaseRequestId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([leadPurchaseId])
  @@index([creditPurchaseRequestId])
}

// Solicitud de compra de créditos con pago manual (sección 4): el agente
// elige un paquete y "envía a revisión"; los créditos solo se acreditan
// cuando un admin la aprueba (ver purchase.ts / creditPurchases.ts).
model CreditPurchaseRequest {
  id      String            @id @default(uuid())
  agentId String
  package CreditPackageType
  amount  Decimal           @db.Decimal(12, 2)
  credits Int

  // Comprobante de pago (captura/foto). Nullable porque las solicitudes
  // creadas antes de este campo no lo tienen; para las nuevas, la capa de
  // aplicación lo exige (ver submitCreditPurchaseAction).
  receiptImageData     Bytes?
  receiptImageMimeType String?

  status          CreditPurchaseStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  agent         AgentProfile        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewer      User?               @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  ledgerEntries CreditLedgerEntry[]

  @@index([agentId])
  @@index([status])
}

// ---------- Pagos ----------

model Payment {
  id        String @id @default(uuid())
  agentId   String
  // requestId permite crear el Payment antes de que exista el LeadPurchase
  // (el LeadPurchase solo se crea cuando el webhook confirma el pago).
  requestId String

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("usd")
  status   PaymentStatus @default(PENDING)

  stripePaymentIntentId String? @unique

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent        AgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  request      PropertyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leadPurchase LeadPurchase?

  @@index([agentId])
  @@index([requestId])
  @@index([status])
}

// ---------- Intercambio de contacto ----------

model ContactExchange {
  id             String   @id @default(uuid())
  requestId      String
  leadPurchaseId String   @unique
  buyerId        String
  agentId        String
  revealedAt     DateTime @default(now())

  // Fin de la ventana de protección de contacto (horas configurables, ver
  // SETTINGS.contactProtectionHours). Null para filas creadas antes de esta
  // función (sin backfill, a propósito) o si la protección está desactivada
  // — en ambos casos el contacto se considera accesible de inmediato, igual
  // que el comportamiento histórico. Calculado una sola vez al comprar, no
  // en cada lectura, para que una compra vieja nunca cambie de comportamiento
  // aunque después se edite la configuración de horas.
  protectedUntil DateTime?

  request      PropertyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leadPurchase LeadPurchase    @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([buyerId])
  @@index([agentId])
}

// Log de eventos de revelación de contacto (protección bilateral) —
// separado a propósito de ContactExchange, que sigue representando solo
// el estado de protección de la compra (una fila, calculada una vez al
// comprar) y NO se convierte en un historial. Esta tabla es append-only:
// puede tener varias filas por LeadPurchase, una por cada combinación de
// direction+method efectivamente revelada. Nunca revela el dato
// automáticamente — se crea únicamente cuando el usuario confirma una
// acción explícita de "ver" el contacto, después de la advertencia (ver
// especificación de protección de contactos, sección 3).
//
// Camino A (AGENT_INITIATED): initiatedByUserId = authorizedByUserId =
// revealedByUserId = el agente, contactReleaseRequestId = null.
// Camino B (BUYER_REQUEST_APPROVED): initiatedByUserId = el comprador que
// pidió; authorizedByUserId = revealedByUserId = el agente que aprobó;
// contactReleaseRequestId = la solicitud que lo originó.
model ContactRevealEvent {
  id                      String                 @id @default(uuid())
  leadPurchaseId          String
  direction               ContactRevealDirection
  method                  ContactMethod
  path                    ContactRevealPath
  initiatedByUserId       String
  authorizedByUserId      String
  revealedByUserId        String
  contactReleaseRequestId String?
  noticeVersion           String
  revealedAt              DateTime               @default(now())

  leadPurchase          LeadPurchase           @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)
  contactReleaseRequest ContactReleaseRequest? @relation(fields: [contactReleaseRequestId], references: [id], onDelete: SetNull)
  initiatedBy           User                   @relation("ContactRevealInitiatedBy", fields: [initiatedByUserId], references: [id])
  authorizedBy          User                   @relation("ContactRevealAuthorizedBy", fields: [authorizedByUserId], references: [id])
  revealedBy            User                   @relation("ContactRevealRevealedBy", fields: [revealedByUserId], references: [id])

  // Revelar el mismo método, en la misma dirección, dos veces no crea una
  // fila nueva — mismo criterio que PropertyShare.@@unique.
  @@unique([leadPurchaseId, direction, method])
  @@index([leadPurchaseId])
}

// Camino B: el comprador pide compartir contacto externo; el agente
// aprueba o rechaza. Separado de ContactRevealEvent a propósito: una
// solicitud es un proceso con estados y transiciones; un reveal es un
// hecho consumado e irreversible. Máximo una PENDING por LeadPurchase,
// garantizado por el índice único parcial de la migración (no expresable
// en el DSL de Prisma, igual que PropertyImage.isPrimary) además del
// lock transaccional sobre LeadPurchase.
model ContactReleaseRequest {
  id                    String                      @id @default(uuid())
  leadPurchaseId        String
  requestedByUserId     String
  status                ContactReleaseRequestStatus @default(PENDING)
  noticeVersion         String // aceptación del comprador al pedir
  approvalNoticeVersion String? // aceptación del agente al aprobar — null mientras esté pendiente
  requestedAt           DateTime                    @default(now())
  decidedAt             DateTime?
  decidedByUserId       String?

  leadPurchase LeadPurchase         @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)
  requestedBy  User                 @relation("ContactReleaseRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy    User?                @relation("ContactReleaseDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  reveals      ContactRevealEvent[]

  @@index([leadPurchaseId])
  @@index([status])
}

// Historial completo de intentos de devolución — una fila por intento,
// nunca se sobrescribe ni se borra. category es inmutable tras crear:
// ninguna función de servicio la modifica. Máximo una PENDING por
// LeadPurchase, igual mecanismo que ContactReleaseRequest.
// leadPurchaseStatusBefore permite revertir LeadPurchase.status al valor
// exacto previo si se rechaza, en vez de un estado terminal fijo — así
// una nueva RefundRequest puede presentarse después, sujeta a las reglas
// de elegibilidad vigentes en ese momento.
model RefundRequest {
  id                       String                @id @default(uuid())
  leadPurchaseId           String
  requestedByUserId        String
  category                 RefundRequestCategory
  reason                   String
  evidence                 String?
  status                   RefundRequestStatus   @default(PENDING)
  leadPurchaseStatusBefore LeadPurchaseStatus
  requestedAt              DateTime              @default(now())
  decidedAt                DateTime?
  decidedByUserId          String?
  decisionReason           String?

  leadPurchase LeadPurchase @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy    User?        @relation("RefundDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([leadPurchaseId])
  @@index([status])
}

// ---------- Conversación ----------

// Hilo de mensajes de una oportunidad comercial concreta (PR #16). Ancla
// 1:1 a LeadPurchase — mismo patrón que ContactExchange.leadPurchaseId —
// porque LeadPurchase ya es la identidad única de "este agente con esta
// solicitud" (@@unique([requestId, agentId]) en LeadPurchase): dos
// solicitudes del mismo comprador con el mismo agente generan dos
// LeadPurchase y, por lo tanto, dos Conversation distintas — nunca se
// mezclan oportunidades comerciales distintas.
//
// Se crea automáticamente dentro de la misma transacción que crea el
// LeadPurchase (ver purchaseWithCredits en purchase.ts) — nunca de forma
// perezosa en el primer mensaje. Sin backfill: los LeadPurchase previos a
// este PR quedan sin Conversation.
//
// Deliberadamente sin un campo de estado propio (ConversationStatus): la
// posibilidad de escribir se determinará en un PR posterior a partir de
// LeadPurchase.status / PropertyRequest.status — la conversación no debe
// convertirse en una segunda fuente de verdad del lifecycle.
model Conversation {
  id             String   @id @default(uuid())
  leadPurchaseId String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leadPurchase LeadPurchase          @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]
}

// Mensaje individual dentro de una Conversation (PR #16). Solo esquema:
// las reglas de quién puede enviar, longitud máxima y frecuencia se
// implementan en el servicio de PR #17 — Prisma no puede expresarlas como
// CHECK constraints. Reglas de negocio que el servicio deberá aplicar:
//   - type TEXT           → body obligatorio (no vacío).
//   - type PROPERTY_SHARE → propertyShareId obligatorio, y debe apuntar a
//     un PropertyShare ya existente (creado por shareProperty()) — este
//     modelo nunca duplica propertyId/title/price/foto, solo referencia la
//     fila que ya es la única fuente de verdad (ver PropertyShare arriba).
//   - senderUserId siempre debe ser un participante autorizado de la
//     Conversation (el agente o el comprador del LeadPurchase ancla) —
//     se valida en el servicio, nunca a nivel de esquema.
//
// senderUserId es obligatorio: todo mensaje real tiene un remitente — no
// hay mensajes de sistema todavía (eso es ConversationMessageType.SYSTEM,
// explícitamente diferido a un PR futuro). Por ser obligatorio, la
// relación hacia User NO puede usar onDelete: SetNull (Postgres fallaría
// en tiempo de ejecución al intentar dejar NULL una columna NOT NULL, ver
// el informe de PR #16); se omite onDelete y se usa el default de Prisma
// para relaciones obligatorias (RESTRICT) — hoy no existe ningún flujo que
// borre un User, así que esto no cambia ningún comportamiento actual, solo
// evita que un borrado futuro corrompa en silencio el historial de
// mensajes.
model ConversationMessage {
  id              String                  @id @default(uuid())
  conversationId  String
  senderUserId    String
  type            ConversationMessageType @default(TEXT)
  body            String?
  propertyShareId String?
  createdAt       DateTime                @default(now())
  // Fase 1 de chat en tiempo real: sin ambigüedad de "leído por quién"
  // porque cada Conversation tiene exactamente 2 participantes (el agente y
  // el comprador del LeadPurchase ancla) — un mensaje nunca necesita más de
  // una marca de lectura. Null = no leído todavía por el destinatario.
  readAt          DateTime?

  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User           @relation(fields: [senderUserId], references: [id])
  propertyShare PropertyShare? @relation(fields: [propertyShareId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([propertyShareId])
  // Soporta los conteos de "no leídos" (por conversación y globales del
  // header) sin recorrer todos los mensajes — el filtro más selectivo es
  // readAt IS NULL (la minoría de las filas).
  @@index([readAt])
}

// Historial de cambios de estado, tanto de la solicitud como de una compra
// puntual (se guarda como texto libre para poder registrar ambos enums).
model LeadStatusHistory {
  id              String   @id @default(uuid())
  requestId       String
  leadPurchaseId  String?
  fromStatus      String
  toStatus        String
  reason          String?
  changedByUserId String?
  createdAt       DateTime @default(now())

  request      PropertyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leadPurchase LeadPurchase?   @relation(fields: [leadPurchaseId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

// ---------- Notificaciones ----------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ---------- Admin ----------

model AdminSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Eventos de analítica simple (sección 34), guardados en DB en vez de un
// proveedor externo.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  requestId String?
  agentId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([requestId])
}
